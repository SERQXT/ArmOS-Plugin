# Per-instance Domo developer tokens (see mcp.example.json). Copy this file to
# .env in your PROJECT root (not inside the plugin) and fill in real values.
# .env is git-ignored.
#
# Convention: each customer gets its own MCP server in .mcp.json named
# `domo-<instance>` in a consistent layout — an X-DOMO-DEVELOPER-TOKEN header
# whose value is `${DOMO_<INSTANCE_UPPER_SNAKE>_DEVELOPER_TOKEN}`. Add one line
# here per instance, matching that env var name. Generate tokens in each Domo
# instance under Admin -> Authentication -> Access Tokens.

# domo-mcp (primary / active-customer server). This is the server /server
# repoints; its token var tracks whatever instance it currently points at.
DOMO_SIMPLYTHANKYOU_CO_UK_1_DEVELOPER_TOKEN=your-simplythankyou-co-uk-1-developer-token-here

# domo-wings (wings-travel.domo.com).
DOMO_WINGS_DEVELOPER_TOKEN=your-wings-travel-developer-token-here

# Anonymous toolkits (e.g. domo-stark, domo-valuedynamx) need NO token — their
# toolkit connects anonymously, so they have no header in .mcp.json and no var here.

# domo-artsoftwaregroup (artsoftwaregroup.domo.com).
DOMO_ARTSOFTWAREGROUP_DEVELOPER_TOKEN=your-artsoftwaregroup-developer-token-here
